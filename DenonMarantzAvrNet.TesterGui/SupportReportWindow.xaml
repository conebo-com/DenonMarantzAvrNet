<Window x:Class="DenonMarantzAvrNet.TesterGui.SupportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support report" Height="780" Width="1050"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid x:Name="GrdMain" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="StcHeader" Grid.Row="0" Margin="0,0,0,8">
            <Border x:Name="BrdIntro" Padding="12,10" CornerRadius="4"
                    Background="#E8F1FB" BorderBrush="#2F6DB5" BorderThickness="1">
                <TextBlock x:Name="TxtIntro" TextWrapping="Wrap"
                           FontSize="15" FontWeight="Bold" Foreground="#1F4E8C"
                           Text="Check whether your receiver works with the functions of this tester and help the project with the result.&#10;1. Choose the report type below. 'Anonymized' leaves out your MAC address and host.&#10;2. Click 'Run read-only operations'. Values are only read; nothing is changed on your receiver.&#10;3. Check the results in the list: green = ok, yellow = warning, red = error.&#10;4. Click 'Prepare for sending', copy the report and paste it into an e-mail yourself. Nothing is sent automatically." />
            </Border>
            <Border x:Name="BrdCompatibilityMode" Visibility="Collapsed" Margin="0,6,0,0" Padding="6"
                    Background="#FFF3E0" BorderBrush="DarkOrange" BorderThickness="1">
                <TextBlock x:Name="TxtCompatibilityMode" TextWrapping="Wrap" FontWeight="Bold" Foreground="DarkOrange" />
            </Border>
        </StackPanel>
        
        <StackPanel x:Name="StcOptions" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="LblReportType" Text="Report type:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="RdoRegular" Content="Regular" GroupName="ReportType" IsChecked="True"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton x:Name="RdoAnonymized" Content="Anonymized (no MAC address, serial number or host)"
                         GroupName="ReportType" VerticalAlignment="Center" />
            <Button x:Name="BtnRun" Content="Run read-only operations" Padding="10,2" Margin="24,0,0,0"
                    Click="BtnRun_Click" />
            <TextBlock x:Name="TxtProgress" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Grid x:Name="GrdContent" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="BrdOperations" Grid.Column="0" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1">
                <ListView x:Name="LstOperations" SelectionChanged="LstOperations_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid x:Name="GrdRight" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblResultHeading" Grid.Row="0" Text="Result of the selected operation" FontWeight="Bold" />
                <TextBox x:Name="TxtResult" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" />

                <StackPanel x:Name="StcIndividualInformation" Grid.Row="4" Margin="0,0,0,8">
                    <TextBlock x:Name="LblIndividualInformation" Text="Individual information (what ever you want to tell us ;-)" FontWeight="Bold" />
                    <TextBox x:Name="TxtIndividualInformation" Height="110" Margin="0,2,0,0" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel x:Name="StcChecks" Grid.Row="5" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkMayContact"
                              Content="The project may contact me by e-mail if there are questions about this report" />
                    <CheckBox x:Name="ChkProjectNews" Margin="0,4,0,0"
                              Content="Keep me informed by e-mail about changes to the project" />
                </StackPanel>

                <Button x:Name="BtnPrepare" Grid.Row="6" Content="Prepare for sending" Height="30"
                        Click="BtnPrepare_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>